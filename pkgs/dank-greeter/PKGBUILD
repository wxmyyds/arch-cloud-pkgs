# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版 dank-greeter：DMS Greeter 登录界面，重打包上游官方预编译单二进制
# （Go 静态二进制 + UI 内嵌，不耦合 glibc，无需月度重建；版本构建时自动跟随最新 release）
# 升级方法：无需修改 pkgver；构建时解析 releases/latest 取最新 tag（302 + API 兜底），
#          二进制/completions 的 SHA256 从 release 附带的 *.sha256 动态解析，
#          LICENSE/README/tmpfiles/examples 等 raw 源文件流式计算 SHA256，
#          makepkg 下载后落地即校验（同 rtk 包对 LICENSE 的做法）
# 注意：本包替代旧包名 greetd-dms-greeter-bin（本机原为 v1.5.2 旧架构 bash wrapper
#      + QML 树，新架构为单二进制内嵌 UI）。pacman -U 时按提示移除旧包即可；
#      /etc/greetd/config.toml 归 greetd 包所有且命令行兼容，无需改动；
#      装完需执行 sudo dms-greeter sync 重建缓存结构（替代旧的 dms greeter sync）

pkgname=dank-greeter
_binname=dms-greeter
pkgrel=1

_dank_greeter_latest_tag() {
    local tag
    tag="$(curl -fsSI -o /dev/null -w '%{redirect_url}' \
        'https://github.com/AvengeMedia/dank-greeter/releases/latest' \
        | sed -E 's|.*/tag/([^[:space:]]+).*|\1|' | tr -d '\r')"
    if [[ -z "$tag" ]]; then
        # 302 解析失败回退 GitHub API（releases/latest 只指向非 prerelease 稳定版）
        tag="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
            'https://api.github.com/repos/AvengeMedia/dank-greeter/releases/latest' \
            | awk '/"tag_name":/{print $2}' | tr -d ',"')"
    fi
    [[ -n "$tag" ]] || return 1
    printf '%s\n' "$tag"
}

_tag="$(_dank_greeter_latest_tag)" || {
    echo >&2 "!! 无法解析 dank-greeter 最新 release tag，网络或仓库结构可能已变化"
    exit 1
}
pkgver="${_tag#v}"
[[ "$pkgver" =~ ^[0-9]+(\.[0-9]+)+$ ]] || {
    echo >&2 "!! 解析出版本号异常：${pkgver:-（空）}"
    exit 1
}

# release 资产的 SHA256 直接取上游同名 *.sha256（首字段，64 位 hex 格式校验）；
# raw 源文件（无上游校验文件）流式计算。均为同 tag 内容，随版本自动更新。
_release_sha() {
    local sha
    sha="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
        "https://github.com/AvengeMedia/dank-greeter/releases/download/${_tag}/$1.sha256" \
        | awk '{print $1}' | head -n1)"
    [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$sha"
}
_raw_sha() {
    local sha
    # pipefail：curl 失败时管道整体报错，防止把空输入（e3b0c442…）当成合法哈希
    sha="$(set -o pipefail; curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
        "https://raw.githubusercontent.com/AvengeMedia/dank-greeter/${_tag}/$1" | sha256sum | cut -d' ' -f1)" || return 1
    [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$sha"
}

_lic_sha="$(_raw_sha LICENSE)"            || { echo >&2 "!! LICENSE 获取/校验失败"; exit 1; }
_readme_sha="$(_raw_sha README.md)"       || { echo >&2 "!! README 获取/校验失败"; exit 1; }
_tmpf_sha="$(_raw_sha assets/systemd/tmpfiles-$_binname.conf)" || { echo >&2 "!! tmpfiles 配置获取/校验失败"; exit 1; }
_niri_sha="$(_raw_sha assets/examples/dms-niri.kdl)"  || { echo >&2 "!! dms-niri.kdl 获取/校验失败"; exit 1; }
_hypr_sha="$(_raw_sha assets/examples/dms-hypr.conf)" || { echo >&2 "!! dms-hypr.conf 获取/校验失败"; exit 1; }
_hyprl_sha="$(_raw_sha assets/examples/dms-hypr.lua)" || { echo >&2 "!! dms-hypr.lua 获取/校验失败"; exit 1; }
_comp_sha="$(_release_sha "$_binname-completions-$pkgver.tar.gz")" || { echo >&2 "!! completions *.sha256 解析失败，上游资产名可能已变化"; exit 1; }
_bin_sha="$(_release_sha "$_binname-linux-amd64.gz")" || { echo >&2 "!! 二进制 *.sha256 解析失败，上游资产名可能已变化"; exit 1; }
pkgdesc='Greetd login screen with the Dank Material aesthetic (upstream prebuilt binary)'
arch=('x86_64')
url='https://github.com/AvengeMedia/dank-greeter'
license=('MIT')
depends=('greetd' 'quickshell' 'qt6-declarative')
optdepends=(
    'niri: Niri compositor support'
    'hyprland: Hyprland compositor support'
    'sway: Sway compositor support'
)
# 二进制名与包名不一致，依赖二进制名的包经 provides 解析
provides=("$_binname=$pkgver")
# 覆盖全部家族变体：本机旧 -bin、AUR -bin/-git、跨发行版名 dms-greeter
conflicts=("$_binname" 'greetd-dms-greeter' 'greetd-dms-greeter-bin' 'greetd-dms-greeter-git')

# 重打包保真：不剥离不拆分上游二进制（本机 makepkg.conf 若开 strip 会改动上游 Go 二进制）
options=('!strip' '!debug')

install=dank-greeter.install

source=(
  "LICENSE-$pkgver::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/${_tag}/LICENSE"
  "README-$pkgver.md::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/${_tag}/README.md"
  "tmpfiles-$_binname-$pkgver.conf::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/${_tag}/assets/systemd/tmpfiles-$_binname.conf"
  "dms-niri-$pkgver.kdl::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/${_tag}/assets/examples/dms-niri.kdl"
  "dms-hypr-$pkgver.conf::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/${_tag}/assets/examples/dms-hypr.conf"
  "dms-hypr-$pkgver.lua::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/${_tag}/assets/examples/dms-hypr.lua"
  "$_binname-completions-$pkgver.tar.gz::https://github.com/AvengeMedia/dank-greeter/releases/download/${_tag}/$_binname-completions-$pkgver.tar.gz"
)
source_x86_64=("$_binname-linux-amd64-$pkgver.gz::https://github.com/AvengeMedia/dank-greeter/releases/download/${_tag}/$_binname-linux-amd64.gz")
# 全部随版本自动解析，无需人工维护（见上方 _raw_sha/_release_sha）
sha256sums=("$_lic_sha" "$_readme_sha" "$_tmpf_sha" "$_niri_sha" "$_hypr_sha" "$_hyprl_sha" "$_comp_sha")
sha256sums_x86_64=("$_bin_sha")

package() {
  cd "${srcdir}"

  # makepkg 对裸 .gz 自动解压，得到 $_binname-linux-amd64-$pkgver
  install -Dm755 "${_binname}-linux-amd64-${pkgver}" "${pkgdir}/usr/bin/${_binname}"

  install -Dm644 "${_binname}"      "${pkgdir}/usr/share/bash-completion/completions/${_binname}"
  install -Dm644 "_${_binname}"     "${pkgdir}/usr/share/zsh/site-functions/_${_binname}"
  install -Dm644 "${_binname}.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/${_binname}.fish"

  # 创建并管理 greeter 缓存目录权限（0750 greeter:greeter，类型 d 不会清空已有内容）
  install -Dm644 "tmpfiles-$_binname-$pkgver.conf" "${pkgdir}/usr/lib/tmpfiles.d/$_binname.conf"

  install -Dm644 "dms-niri-$pkgver.kdl"  "${pkgdir}/usr/share/doc/${pkgname}/examples/dms-niri.kdl"
  install -Dm644 "dms-hypr-$pkgver.conf" "${pkgdir}/usr/share/doc/${pkgname}/examples/dms-hypr.conf"
  install -Dm644 "dms-hypr-$pkgver.lua"  "${pkgdir}/usr/share/doc/${pkgname}/examples/dms-hypr.lua"

  install -Dm644 "LICENSE-$pkgver"   "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "README-$pkgver.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
