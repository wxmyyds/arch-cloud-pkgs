# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版 dank-greeter：DMS Greeter 登录界面，重打包上游官方预编译单二进制
# （Go 静态二进制 + UI 内嵌，不耦合 glibc，无需月度重建，仅上游发版时升级）
# 升级方法：改 pkgver 为上游新 tag，并更新 sha256sums——
#          二进制和 completions 直接取 release 附带的 *.sha256 文件；
#          LICENSE/README/tmpfiles/examples 用 curl -sL <url> | sha256sum 取值
# 注意：本包替代旧包名 greetd-dms-greeter-bin（本机原为 v1.5.2 旧架构 bash wrapper
#      + QML 树，新架构为单二进制内嵌 UI）。pacman -U 时按提示移除旧包即可；
#      /etc/greetd/config.toml 归 greetd 包所有且命令行兼容，无需改动；
#      装完需执行 sudo dms-greeter sync 重建缓存结构（替代旧的 dms greeter sync）

pkgname=dank-greeter
_binname=dms-greeter
pkgver=1.6.2
pkgrel=1
pkgdesc='Greetd login screen with the Dank Material aesthetic (upstream prebuilt binary)'
arch=('x86_64')
url='https://github.com/AvengeMedia/dank-greeter'
license=('MIT')
depends=('greetd' 'quickshell' 'qt6-declarative')
optdepends=(
    'niri: Niri compositor support'
    'hyprland: Hyprland compositor support'
    'sway: Sway compositor support'
)
# 二进制名与包名不一致，依赖二进制名的包经 provides 解析
provides=("$_binname=$pkgver")
# 覆盖全部家族变体：本机旧 -bin、AUR -bin/-git、跨发行版名 dms-greeter
conflicts=("$_binname" 'greetd-dms-greeter' 'greetd-dms-greeter-bin' 'greetd-dms-greeter-git')

# 重打包保真：不剥离不拆分上游二进制（本机 makepkg.conf 若开 strip 会改动上游 Go 二进制）
options=('!strip' '!debug')

install=dank-greeter.install

source=(
  "LICENSE-$pkgver::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/v$pkgver/LICENSE"
  "README-$pkgver.md::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/v$pkgver/README.md"
  "tmpfiles-$_binname-$pkgver.conf::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/v$pkgver/assets/systemd/tmpfiles-$_binname.conf"
  "dms-niri-$pkgver.kdl::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/v$pkgver/assets/examples/dms-niri.kdl"
  "dms-hypr-$pkgver.conf::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/v$pkgver/assets/examples/dms-hypr.conf"
  "dms-hypr-$pkgver.lua::https://raw.githubusercontent.com/AvengeMedia/dank-greeter/v$pkgver/assets/examples/dms-hypr.lua"
  "$_binname-completions-$pkgver.tar.gz::https://github.com/AvengeMedia/dank-greeter/releases/download/v$pkgver/$_binname-completions-$pkgver.tar.gz"
)
source_x86_64=("$_binname-linux-amd64-$pkgver.gz::https://github.com/AvengeMedia/dank-greeter/releases/download/v$pkgver/$_binname-linux-amd64.gz")

sha256sums=('0c4c01a73eb7d2d1286a7e60e580dd53b605636dc46a57c9c3318e8e23efc676'
            '21d460b29318eee3d2135eb431fd041a263ae7589e2de6b58e1bc66f771ec9ee'
            '3dc267a18f22d06f595a80fb77275db56fe88c48b838db364ba3a1d307572a50'
            '0376981f71a7331e3a8e5fdf71628f8c0e3881328969011f31fc1da6d54036c0'
            'ae9e76c0a4af1390866e427de2eac9c9339115008790c06a6605022b0b82b89f'
            '1262f1c8d5e3a19c05d0e5863c54181c7f2c9fe404d69b7ef0629e2c758ffc16'
            'cc652f67d2c404a8bf987c7e624293c66d5aadcd2e8e18a784f12b0d1f2c8c61')
sha256sums_x86_64=('74c2200f98c6e75ba92088c7e30dfea2b32758b6e5888f996a7e9a9688539a4d')

package() {
  cd "${srcdir}"

  # makepkg 对裸 .gz 自动解压，得到 $_binname-linux-amd64-$pkgver
  install -Dm755 "${_binname}-linux-amd64-${pkgver}" "${pkgdir}/usr/bin/${_binname}"

  install -Dm644 "${_binname}"      "${pkgdir}/usr/share/bash-completion/completions/${_binname}"
  install -Dm644 "_${_binname}"     "${pkgdir}/usr/share/zsh/site-functions/_${_binname}"
  install -Dm644 "${_binname}.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/${_binname}.fish"

  # 创建并管理 greeter 缓存目录权限（0750 greeter:greeter，类型 d 不会清空已有内容）
  install -Dm644 "tmpfiles-$_binname-$pkgver.conf" "${pkgdir}/usr/lib/tmpfiles.d/$_binname.conf"

  install -Dm644 "dms-niri-$pkgver.kdl"  "${pkgdir}/usr/share/doc/${pkgname}/examples/dms-niri.kdl"
  install -Dm644 "dms-hypr-$pkgver.conf" "${pkgdir}/usr/share/doc/${pkgname}/examples/dms-hypr.conf"
  install -Dm644 "dms-hypr-$pkgver.lua"  "${pkgdir}/usr/share/doc/${pkgname}/examples/dms-hypr.lua"

  install -Dm644 "LICENSE-$pkgver"   "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "README-$pkgver.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
