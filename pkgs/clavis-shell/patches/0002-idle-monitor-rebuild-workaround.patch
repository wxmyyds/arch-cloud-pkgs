     readonly property string policyConfigDir: Paths.configHome
     readonly property string policyConfigPath: policyConfigDir + "/idle-policy.json"
     readonly property bool policyReady: policyStoreReady && !policyLoading
+    // One-shot gate: IdleMonitors must not create notifications until the policy
+    // has been loaded once with its final values. Unlike policyReady it never
+    // flips again, so a later policy reload cannot destroy and recreate the
+    // notifications (quickshell bug #938 can drop isIdle, and a bindable merge
+    // may leave a monitor without any notification at all).
+    property bool policyLoaded: false
     property bool policyStoreReady: false
     property bool policyLoading: true
 
@@ -233,7 +239,28 @@ Singleton {
     }
 
     function _monitorEnabled(stageEnabled, timeout, respectInhibitors) {
-        return root.policyEnabled && stageEnabled && timeout > 0 && !(respectInhibitors && root.inhibited);
+        // quickshell's IdleMonitor loses its isIdle subscription whenever the
+        // underlying ext_idle_notification_v1 is destroyed and recreated at the
+        // same address (upstream bug #938, fix #1097 not yet merged). Clavis'
+        // policy loads asynchronously, so every stage would otherwise be created
+        // with default values and immediately recreated with the user's values,
+        // leaving isIdle permanently false and lock/display-off/suspend dead.
+        // Gate creation behind the one-shot policyLoaded flag, and let
+        // scheduleRecycle() force a clean recreation on later config changes.
+        return root.policyLoaded && root.policyEnabled && stageEnabled && timeout > 0
+                && !(respectInhibitors && root.inhibited);
+    }
+
+    function scheduleRecycle(monitor) {
+        // Toggle the stage's IdleMonitor enabled=false -> true so its
+        // notification is destroyed and recreated with the new timeout/
+        // respectInhibitors. bNotification transitions through null, forcing the
+        // isIdle binding to re-subscribe on the new object even when the
+        // compositor reuses the same heap address.
+        if (!root.policyLoaded)
+            return;
+        monitor.recycle = true;
+        Qt.callLater(() => { monitor.recycle = false; });
     }
 
     function _setDimmed(value) {
