# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版微信 Linux：腾讯官方 x86_64 AppImage 重打包为 Arch 包。
# 升级方法：无需修改 pkgver；构建时从官网解析当前版本。手动 workflow_dispatch
#          指定 wechat 即可获取官网当时的最新版。
#
# 官网目前只提供固定下载地址，页面未提供可用于 PKGBUILD 的 SHA-256 校验值。
# 因此 AppImage 本身的 sha256sums 使用 SKIP；但 AppImage 内部自带
# wechat-payload.tar 与 wechat-payload.sha256，prepare() 会严格校验 payload 摘要，
# 并检查文件体积、AppImage type-2 魔数、payload 路径与符号链接安全。这些检查不能
# 替代官方签名，但可避免错误响应和上游打包结构变化被静默接受。
#
# 上游 AppImage 结构（2026-11 起）：AppRun + install-apparmor.sh + wechat.desktop +
# wechat.png + wechat-payload.tar（内部即原 /opt/wechat 目录内容）+ 摘要清单。
# 官方 AppRun 会把 payload 安装到 /opt/wechat-appimage/app 并配置 AppArmor/SUID。
# 本包改为直接解包 payload 到 /opt/wechat 并由 /usr/bin/wechat 启动：不依赖 FUSE、
# 不需要 root 首次安装、不安装 AppArmor 规则，也不设置 SUID sandbox（Arch 默认
# 允许非特权 user namespace，CEF 走 namespace sandbox 即可）。

pkgname=wechat
# 预编译 AppImage 包含大量内置 ELF；namcap 扫描约 1 GB 产物会严重拖慢 CI。
# 工作流默认执行 namcap，仅此包显式关闭；该字段由 workflow 以纯文本方式读取，不会 source PKGBUILD。
namcap_check=false
pkgrel=2

_wechat_latest() {
    local page ver

    page="$(curl -fsSL --connect-timeout 15 --max-time 60 \
        'https://linux.weixin.qq.com/')" || return 1

    # 版本号锚定服务端渲染的 class="main-section__bd-version" 元素，不回退到
    # 同名 CSS 选择器文本，也不从 ARM 区域或页面任意数字取值。
    ver="$(grep -oE 'class="main-section__bd-version"[^>]*>[0-9]+(\.[0-9]+)+' <<< "$page" \
        | head -n1 | sed -E 's/.*>//')"
    [[ -n "$ver" ]] || return 1

    # 页面必须同时仍然公开 x86_64 AppImage；否则宁可失败，不下载错误平台。
    grep -Fq 'https://dldir1v6.qq.com/weixin/Universal/Linux/WeChatLinux_x86_64.AppImage' <<< "$page" || return 1
    printf '%s\n' "$ver"
}

pkgver="$(_wechat_latest)" || {
    echo >&2 "!! 无法从微信 Linux 官网解析 x86_64 版本号，页面结构可能已改版"
    exit 1
}
[[ "$pkgver" =~ ^[0-9]+(\.[0-9]+)+$ ]] || {
    echo >&2 "!! 解析出版本号异常：${pkgver:-（空）}"
    exit 1
}

pkgdesc="腾讯官方微信 Linux 桌面客户端（x86_64 AppImage 重打包）"
arch=('x86_64')
url="https://linux.weixin.qq.com/"
license=('LicenseRef-Proprietary')
# AppImage 已内置 Qt/Chromium(CEF)/VLC 等应用库；以下为主程序与内嵌 CEF 运行时
# 直接使用、由系统提供的图形、音频、DBus、字体、证书与图标组件。libatomic /
# gcc-libs 提供 libatomic、libstdc++、libgcc_s。wayland 供原生 Wayland 后端按需
# dlopen（X11 下不需要）。
depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'cups'
    'dbus'
    'expat'
    'fontconfig'
    'gcc-libs'
    'glib2'
    'glibc'
    'libatomic'
    'libglvnd'
    'libice'
    'libpulse'
    'libsm'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'wayland'
    'xcb-util-keysyms'
    'zlib'
)
makedepends=('desktop-file-utils')

_source_url='https://dldir1v6.qq.com/weixin/Universal/Linux/WeChatLinux_x86_64.AppImage'
source=("WeChatLinux_x86_64-${pkgver}.AppImage::${_source_url}")
sha256sums=('SKIP')

# 这是已编译的 Qt/CEF 应用，禁止 strip/debug 分包；保留 AppImage 内部的符号链接
# 和相对目录结构，避免破坏 RPATH/RUNPATH=$ORIGIN。
options=('!strip' '!debug' '!emptydirs')

# payload 解包到 $srcdir/wechat-files，prepare 与 package 共享该目录。注意 srcdir
# 由 makepkg 在 source PKGBUILD 之后才设置，故不能在顶层引用，各函数内按需计算。

prepare() {
    cd "$srcdir"
    local payload_dir="$srcdir/wechat-files"
    local image="WeChatLinux_x86_64-${pkgver}.AppImage"

    if [[ ! -f "$image" ]]; then
        echo >&2 "!! 源文件 $image 缺失，下载未落盘"
        return 1
    fi

    local size digest
    size="$(stat -L -c%s "$image")"
    if (( size < 52428800 )); then
        echo >&2 "!! ${image} 体积异常（${size} 字节），疑似错误响应"
        return 1
    fi
    # AppImage type 2 的 ELF runtime 后偏移 8 字节为 AI + 版本号 2。
    if [[ "$(dd if="$image" bs=1 skip=8 count=3 2>/dev/null)" != $'AI\002' ]]; then
        echo >&2 "!! AppImage type-2 魔数校验失败"
        return 1
    fi

    digest="$(sha256sum "$image" | cut -d' ' -f1)"
    printf '微信 AppImage: %s (%s bytes)\nSHA-256: %s\n' "$image" "$size" "$digest"

    chmod +x "$image"
    # --appimage-extract 只解包，不依赖 FUSE；GitHub Actions 容器无需挂载权限。
    rm -rf "$srcdir/squashfs-root"
    ./$image --appimage-extract > /dev/null

    local root="$srcdir/squashfs-root"
    [[ -d "$root" ]] || {
        echo >&2 "!! AppImage 解包失败，未生成 squashfs-root"
        return 1
    }

    rm -rf "$payload_dir"
    mkdir -p "$payload_dir"

    if [[ ! -f "$root/wechat-payload.tar" || ! -f "$root/wechat-payload.sha256" ]]; then
        echo >&2 "!! AppImage 缺少 wechat-payload.tar 或其摘要清单，上游布局可能已改版"
        return 1
    fi
    _extract_payload "$root/wechat-payload.tar" "$root/wechat-payload.sha256" "$payload_dir" || return 1

    if [[ ! -x "$payload_dir/wechat" ]]; then
        echo >&2 "!! payload 缺少可执行的 wechat 主程序"
        return 1
    fi

    # 归一化权限，避免 tar 中的组可写位进入包：目录 755、可执行文件 755、其余 644。
    find "$payload_dir" -type d -exec chmod 755 {} +
    find "$payload_dir" -type f -perm /111 -exec chmod 755 {} +
    find "$payload_dir" -type f ! -perm /111 -exec chmod 644 {} +
}

# 校验并安全解包 wechat-payload.tar。
_extract_payload() {
    local tar="$1" manifest_file="$2" payload_dir="$3"
    local manifest actual name entry target resolved
    local entries="$srcdir/.payload-entries"

    manifest="$(tr -d '[:space:]' < "$manifest_file")"
    if [[ ! "$manifest" =~ ^[0-9a-f]{64}$ ]]; then
        echo >&2 "!! wechat-payload.sha256 内容非法"
        return 1
    fi
    actual="$(sha256sum "$tar" | cut -d' ' -f1)"
    if [[ "$actual" != "$manifest" ]]; then
        echo >&2 "!! wechat-payload.tar 摘要不匹配：期望 $manifest，实际 $actual"
        return 1
    fi
    printf '微信 payload: %s\nSHA-256: %s\n' "$tar" "$actual"

    # 拒绝绝对路径和 .. 组件；GNU tar 默认也会拦截，这里提前显式失败。
    while IFS= read -r name; do
        case "$name" in
            /*|../*|*/../*|..)
                echo >&2 "!! payload 含不安全路径：$name"
                return 1
                ;;
        esac
    done < <(tar -tf "$tar")

    # GNU tar 的默认路径与链接保护生效于全新的私有目录；不追加 -P/--dereference。
    (
        umask 022
        tar --extract --file "$tar" --directory "$payload_dir" \
            --no-same-owner --no-same-permissions --delay-directory-restore \
            --no-acls --no-xattrs --no-selinux
    ) || {
        echo >&2 "!! 解包 payload 失败"
        return 1
    }

    # 符号链接必须为相对路径且解析后仍位于 payload 目录内。
    find -P "$payload_dir" -print0 > "$entries" || {
        echo >&2 "!! 无法枚举 payload 内容"
        return 1
    }
    while IFS= read -r -d '' entry; do
        if [[ -L "$entry" ]]; then
            target="$(readlink -- "$entry")" || {
                echo >&2 "!! 无法读取符号链接：$entry"
                return 1
            }
            if [[ "$target" == /* ]]; then
                echo >&2 "!! payload 符号链接不得使用绝对目标：$entry -> $target"
                return 1
            fi
            resolved="$(realpath -m -- "$entry")" || {
                echo >&2 "!! 无法解析符号链接：$entry"
                return 1
            }
            if [[ "$resolved" != "$payload_dir" && "$resolved" != "$payload_dir/"* ]]; then
                echo >&2 "!! payload 符号链接逃逸出目标目录：$entry -> $target"
                return 1
            fi
        elif [[ ! -f "$entry" && ! -d "$entry" ]]; then
            echo >&2 "!! payload 含特殊文件：$entry"
            return 1
        fi
    done < "$entries"
    rm -f "$entries"
}

package() {
    local root="$srcdir/squashfs-root" payload_dir="$srcdir/wechat-files"

    if [[ ! -x "$payload_dir/wechat" ]]; then
        echo >&2 "!! payload 未准备好：$payload_dir/wechat 不存在或不可执行"
        return 1
    fi

    # 程序内部通过 $ORIGIN 查找捆绑库，原样保留目录结构。--no-preserve=ownership
    # 丢弃解包用户的属主，随后统一归属 root（makepkg 在 fakeroot 下运行）。
    install -d "$pkgdir/opt/wechat"
    cp -a --no-preserve=ownership "$payload_dir/." "$pkgdir/opt/wechat/"
    chown -hR 0:0 "$pkgdir/opt/wechat"
    find "$pkgdir/opt/wechat" -type d -exec chmod 755 {} +
    chmod 755 "$pkgdir/opt/wechat/wechat"

    # 稳定入口：不调用原始 AppRun，直接执行主程序；其 ELF 使用 $ORIGIN
    # RPATH/RUNPATH 查找同目录的内置库，不需要 FUSE 或 --no-sandbox。
    install -Dm755 /dev/null "$pkgdir/usr/bin/wechat"
    cat > "$pkgdir/usr/bin/wechat" <<'EOF'
#!/bin/sh
cd /opt/wechat || exit 1
exec /opt/wechat/wechat "$@"
EOF

    install -d "$pkgdir/usr/share/applications"
    sed -e 's|^Exec=AppRun %U$|Exec=/usr/bin/wechat %U|' \
        -e '/^X-AppImage-Version=/d' \
        "$root/wechat.desktop" > "$pkgdir/usr/share/applications/wechat.desktop"
    if ! grep -q '^Exec=/usr/bin/wechat %U$' "$pkgdir/usr/share/applications/wechat.desktop"; then
        echo >&2 "!! wechat.desktop Exec 改写失败，上游文件结构可能已变化"
        return 1
    fi
    desktop-file-validate "$pkgdir/usr/share/applications/wechat.desktop"

    # AppImage 只提供一枚 1024x1024 PNG，安装到 pixmaps 后可由 Icon=wechat 查找。
    install -Dm644 "$root/wechat.png" "$pkgdir/usr/share/pixmaps/wechat.png"
}
