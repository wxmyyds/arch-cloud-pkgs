# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版 google-chrome：Google 官方 stable 频道 amd64 .deb 重打包为 Arch 包。
# 升级方法：无需修改 pkgver；构建时从 Google apt 仓库 Packages 索引解析当前
#          stable 版本与 SHA256（同一 TLS 索引，动态写入 sha256sums，makepkg
#          落地即校验）。每月定时重建或手动 workflow_dispatch 指定 google-chrome
#          即取当时最新。
#
# 注意：AUR 有同名包 google-chrome（同一思路的打包）——paru -Syu 若提示"升级"
#      到 AUR 的相同/相近版本，跳过即可，以本仓库 bump 节奏为准。
#
# deb 是 ar 归档：makepkg 按内容探测识别后用 bsdtar 解出 debian-binary/
# control.tar.xz/data.tar.xz 三个成员（见 /usr/share/makepkg/source/file.sh 的
# fallback 分支），package() 再解第二层。打包逻辑与 AUR google-chrome 保持一致。
#
# 产物约 370MB；namcap 扫描该体积会严重拖慢 CI。工作流默认执行 namcap，仅此包
# 显式关闭；该字段由 workflow 以纯文本方式读取，不会 source PKGBUILD。
namcap_check=false
pkgname=google-chrome
pkgrel=1

_google_stable_meta() {
    local idx ver sha
    idx="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
        'https://dl.google.com/linux/chrome/deb/dists/stable/main/binary-amd64/Packages')" || return 1
    ver="$(awk '/^Package: google-chrome-stable$/{f=1} f&&/^Version:/{print $2; exit}' <<<"$idx")"
    sha="$(awk '/^Package: google-chrome-stable$/{f=1} f&&/^SHA256:/{print $2; exit}' <<<"$idx")"
    [[ -n "$ver" && -n "$sha" ]] || return 1
    printf '%s\n%s\n' "$ver" "$sha"
}

_meta="$(_google_stable_meta)" || {
    echo >&2 "!! 无法从 Google apt 索引解析 stable 版本与校验值，索引结构可能已变化"
    exit 1
}
_debver="${_meta%%$'\n'*}"
_expected_sha="${_meta##*$'\n'}"
pkgver="${_debver%-*}"
[[ "$pkgver" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || {
    echo >&2 "!! 解析出版本号异常：${pkgver:-（空）}"
    exit 1
}
[[ "$_expected_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo >&2 "!! SHA256 值异常：${_expected_sha:-（空）}"
    exit 1
}

pkgdesc="The popular web browser by Google (Stable Channel)"
arch=('x86_64')
url="https://www.google.com/chrome"
license=('custom:chrome')
# 与 AUR google-chrome 一致的依赖映射
depends=(
    'alsa-lib'
    'gtk3'
    'libcups'
    'libxss'
    'libxtst'
    'nss'
    'ttf-liberation'
    'xdg-utils'
)
optdepends=(
    'pipewire: WebRTC desktop sharing under Wayland'
    'kdialog: for file dialogs in KDE'
    'gnome-keyring: for storing passwords in GNOME keyring'
    'kwallet: for storing passwords in KWallet'
)
# 已编译的闭源浏览器，禁止 strip；deb 内有需保留的空目录
options=('!strip' '!debug' '!emptydirs')
install=google-chrome.install

source=(
    'eula_text.html'
    'google-chrome-stable.sh'
    "google-chrome-stable_${_debver}_amd64.deb::https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_${_debver}_amd64.deb"
)
# 第三项为构建时从同一 apt 索引解析出的 SHA256，随版本自动更新，无需人工维护
sha256sums=(
    'e93c01576427cad9099f2cf0df0be70d0a2cc0a3a66c743318b2138aa7c4ed93'
    '04e973a4c359a87ef63871ec8726e08fabe9919c60f972d5ca6f56f80a2939ed'
    "$_expected_sha"
)

prepare() {
    cd "$srcdir"
    local deb="google-chrome-stable_${_debver}_amd64.deb"

    [[ -f "$deb" ]] || { echo >&2 "!! 源 deb 缺失，下载未落盘"; return 1; }
    local size
    size="$(stat -L -c%s "$deb")"
    if (( size < 52428800 )); then
        echo >&2 "!! deb 体积异常（${size} 字节），疑似错误响应页"
        return 1
    fi
    # deb 是 ar 归档：魔数 '!<arch>'（第 8 字节为换行，命令替换会去尾，故取 7 字节）
    if [[ "$(dd if="$deb" bs=1 count=7 2>/dev/null)" != '!<arch>' ]]; then
        echo >&2 "!! ar 魔数校验失败，疑似非官方 deb"
        return 1
    fi
    # 断言 makepkg 内容探测解出的关键成员在位
    [[ -f data.tar.xz ]] || { echo >&2 "!! data.tar.xz 未被解出"; return 1; }
}

package() {
    bsdtar -xf data.tar.xz -C "$pkgdir/"

    # Launcher（支持 ~/.config/chrome-flags.conf 自定义参数）
    install -m755 google-chrome-stable.sh "$pkgdir"/usr/bin/google-chrome-stable

    # Icons
    for i in 16x16 24x24 32x32 48x48 64x64 128x128 256x256; do
        install -Dm644 "$pkgdir"/opt/google/chrome/product_logo_${i/x*/}.png \
            "$pkgdir"/usr/share/icons/hicolor/$i/apps/google-chrome.png
    done

    # License
    install -Dm644 eula_text.html "$pkgdir"/usr/share/licenses/google-chrome/eula_text.html
    install -Dm644 "$pkgdir"/opt/google/chrome/WidevineCdm/LICENSE \
        "$pkgdir"/usr/share/licenses/google-chrome/WidevineCdm-LICENSE.txt

    # Fix the Chrome desktop entry
    sed -i \
        -e "/Exec=/i\StartupWMClass=Google-chrome" \
        -e "s/x-scheme-handler\/ftp;\?//g" \
        "$pkgdir"/usr/share/applications/google-chrome.desktop

    # Remove the Debian Cron job, duplicate product logos and menu directory
    rm -r \
        "$pkgdir"/etc/cron.daily/ \
        "$pkgdir"/opt/google/chrome/cron/ \
        "$pkgdir"/opt/google/chrome/product_logo_*.png
}
