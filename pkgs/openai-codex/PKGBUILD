# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版 openai-codex：openai/codex 官方 musl 静态二进制重打包
#   - 同款 target：x86_64-unknown-linux-musl（全静态，无任何运行时依赖）
#   - 版本解析：跟随 releases/latest 的 302 取 tag（格式 rust-vX.Y.Z），GitHub API 兜底
#   - 校验：从 release API assets[].digest 取 SHA256（digest 带 sha256: 前缀，awk 剥掉），
#     makepkg 落地即校验；base-devel 容器无 python，全程 curl+awk，不依赖 python
#   - LICENSE 流式计算 SHA256
# 安装位置：/usr/bin/codex（与官方 install.sh 的 ~/.local/bin/codex 不同）；
#   装完请删除手动安装的 ~/.local/bin/codex，避免 PATH 中旧版本遮蔽新版本。
# 升级方法：无需修改 pkgver；每月定时重建或手动 workflow_dispatch 指定 openai-codex
#          即取当时最新 stable。
# 注意：AUR codex-bin 是无关的笔记应用（codexnotes.com），本包 provides/conflicts 它。

pkgname=openai-codex
pkgrel=1

_codex_latest_tag() {
    local tag
    tag="$(curl -fsSI -o /dev/null -w '%{redirect_url}' \
        'https://github.com/openai/codex/releases/latest' \
        | sed -E 's|.*/tag/([^[:space:]]+).*|\1|' | tr -d '\r')"
    if [[ -z "$tag" ]]; then
        tag="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
            'https://api.github.com/repos/openai/codex/releases/latest' \
            | awk '/"tag_name":/{print $2}' | tr -d ',"')"
    fi
    [[ -n "$tag" ]] || return 1
    printf '%s\n' "$tag"
}

_tag="$(_codex_latest_tag)" || {
    echo >&2 "!! 无法解析 openai/codex 最新 release tag，网络或仓库结构可能已变化"
    exit 1
}

# tag 格式：rust-v0.160.0 → pkgver=0.160.0
pkgver="${_tag#rust-v}"
[[ "$pkgver" =~ ^[0-9]+(\.[0-9]+)+$ ]] || {
    echo >&2 "!! 解析出版本号异常：${pkgver:-（空）}"
    exit 1
}

_target="x86_64-unknown-linux-musl"
_asset="codex-${_target}.tar.gz"

# 从 release API 的 assets[].digest 解析 SHA256（与 axolotl-launcher 同款策略：
# API 匿名配额一次取回，awk 匹配 name 后从 digest 字段剥掉 sha256: 前缀）
_tag_json="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
    "https://api.github.com/repos/openai/codex/releases/tags/${_tag}")" || {
    echo >&2 "!! release API 请求失败（可能匿名配额耗尽）"
    exit 1
}
_expected_sha="$(awk -v asset="$_asset" '
    /"name": "/ { name=$0 }
    /"digest": "sha256:/ && index(name, asset) {
        if (match($0, /sha256:[0-9a-f]{64}/)) { print substr($0, RSTART+7, 64); exit }
    }' <<<"$_tag_json")"
[[ "$_expected_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo >&2 "!! release API 中未找到 ${_asset} 的 SHA256 digest"
    exit 1
}

_license_sha="$(set -o pipefail; curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
    "https://raw.githubusercontent.com/openai/codex/${_tag}/LICENSE" | sha256sum | cut -d' ' -f1)"
[[ "$_license_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo >&2 "!! LICENSE 获取失败"
    exit 1
}

pkgdesc="Lightweight coding agent that runs in your terminal (OpenAI Codex CLI)"
arch=('x86_64')
url="https://github.com/openai/codex"
license=('Apache-2.0')
# musl 全静态单文件，无运行时依赖
provides=("codex=${pkgver}")
conflicts=('codex-bin')
options=('!strip' '!debug')

source=(
    "codex-${_tag}-${_target}.tar.gz::https://github.com/openai/codex/releases/download/${_tag}/${_asset}"
    "LICENSE::https://raw.githubusercontent.com/openai/codex/${_tag}/LICENSE"
)
sha256sums=(
    "$_expected_sha"
    "$_license_sha"
)

prepare() {
    cd "$srcdir"
    local tarball="codex-${_tag}-${_target}.tar.gz"
    local binary="codex-${_target}"

    [[ -f "$binary" ]] || {
        echo >&2 "!! 压缩包内未找到 ${binary} 二进制，上游打包结构可能已变化"
        return 1
    }
    local size
    size="$(stat -L -c%s "$tarball")"
    if (( size < 52428800 )); then
        # 二进制约 300+MB，压缩包约 100+MB，低于 50MB 明显异常
        echo >&2 "!! 压缩包体积异常（${size} 字节），疑似错误响应"
        return 1
    fi
    # CWE-22 防御：拒绝绝对路径与目录穿越成员
    if tar -tzf "$tarball" | grep -qE '^/|(^|/)\.\.(/|$)'; then
        echo >&2 "!! 压缩包含不安全路径，拒绝解包"
        return 1
    fi
}

package() {
    install -Dm755 "codex-${_target}" "$pkgdir/usr/bin/codex"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/openai-codex/LICENSE"
}
