# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版 hmcl：Hello Minecraft! Launcher，重打包上游官方预编译 deb
# （Architecture: all 纯 Java 包：/usr/bin/hmcl-stable wrapper +
#   /usr/share/java/hmcl/HMCL-<ver>.sh 自解压主文件——80 行 bash 启动头 +
#   内嵌 jar，JavaFX 已捆绑，启动脚本自带 java 查找逻辑，多架构通用）。
# 升级方法：无需修改 pkgver；构建时解析 releases/latest 取最新 tag（302 + API 兜底），
#          deb 文件名固定为 HMCL-<ver>.deb，SHA256 从该 tag 页 release notes 的
#          File/SHA-256 Checksum 表格动态解析（API assets[].digest 兜底，
#          实测与下载文件一致），makepkg 落地即校验
#
# 注意：
# - AUR 有 hmcl（源码版）与 hmcl-bin（同思路 jar 重打包）——本包即 hmcl 本名，
#   对本机已装任一 AUR 版均为同名/冲突替换，pacman -U 按提示处理即可
# - deb 的 postinst/prerm 仅做 update-alternatives 注册/移除（Arch 无此机制），
#   丢弃不用；入口与版本化 jar 路径整树保留，开箱即用
# - deb control 未声明 Depends（纯 java 运行时）：depends 对齐 AUR，
#   由 java-runtime 虚包解析系统 JDK

pkgname=hmcl
pkgrel=1

_hmcl_latest_tag() {
    local tag
    tag="$(curl -fsSI -o /dev/null -w '%{redirect_url}' \
        'https://github.com/HMCL-dev/HMCL/releases/latest' \
        | sed -E 's|.*/tag/([^[:space:]]+).*|\1|' | tr -d '\r')"
    if [[ -z "$tag" ]]; then
        # 302 解析失败回退 GitHub API（releases/latest 只指向非 prerelease 稳定版）
        tag="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
            'https://api.github.com/repos/HMCL-dev/HMCL/releases/latest' \
            | awk '/"tag_name":/{print $2}' | tr -d ',"')"
    fi
    [[ -n "$tag" ]] || return 1
    printf '%s\n' "$tag"
}

_tag="$(_hmcl_latest_tag)" || {
    echo >&2 "!! 无法解析 HMCL 最新 release tag，网络或仓库结构可能已变化"
    exit 1
}
pkgver="${_tag#v}"
[[ "$pkgver" =~ ^[0-9]+(\.[0-9]+)+$ ]] || {
    echo >&2 "!! 解析出版本号异常：${pkgver:-（空）}"
    exit 1
}

# 从该 tag release 的校验表解析 deb SHA256（随版本自动更新，makepkg 落地即校验）：
# 主路径是 tag 页面的 release notes 表格（File/SHA-256 Checksum，服务端渲染 HTML，
# 不耗 GitHub API 匿名配额）；API 的 assets[].digest 仅作兜底（实测
# 与下载文件逐字节一致，但匿名配额易 403）。
_hmcl_deb_sha() {
    local tag="$1" ver="$2" page sha
    page="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
        "https://github.com/HMCL-dev/HMCL/releases/tag/${tag}")" || return 1
    # 表格行形如 <a ...>HMCL-<ver>.deb</a></td><td><code><sha></code>，先压平换行再取临近 hash
    sha="$(tr -d '\n' <<<"$page" \
        | grep -oE "HMCL-${ver}\\.deb</a></td>[^<]*<td><code>[0-9a-f]{64}</code>" \
        | grep -oE '[0-9a-f]{64}' | head -n1)"
    if [[ "$sha" =~ ^[0-9a-f]{64}$ ]]; then
        printf '%s\n' "$sha"
        return 0
    fi
    # 兜底：API assets[].digest（同一请求的 name 字段限定 deb 资产，避免误取 exe/jar）
    sha="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
        "https://api.github.com/repos/HMCL-dev/HMCL/releases/tags/${tag}" \
        | awk -v asset="HMCL-${ver}.deb" '
            /"name": "/ { name=$0 }
            /"digest": "sha256:/ && index(name, asset) {
                if (match($0, /sha256:[0-9a-f]{64}/)) { print substr($0, RSTART+7, 64); exit }
            }')"
    [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$sha"
}

_expected_sha="$(_hmcl_deb_sha "$_tag" "$pkgver")" || {
    echo >&2 "!! 未找到 HMCL-${pkgver}.deb 的 SHA256，上游 release 校验表结构可能已变化"
    exit 1
}
# LICENSE 无上游校验文件，raw 流式计算（同 dank-greeter）；源文件名带版本号，
# 避免固定 URL 在 CI 的 SRCDEST 缓存中复用旧版本
_license_sha="$(set -o pipefail; curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
    "https://raw.githubusercontent.com/HMCL-dev/HMCL/${_tag}/LICENSE" | sha256sum | cut -d' ' -f1)" || {
    echo >&2 "!! LICENSE 获取失败"
    exit 1
}
[[ "$_license_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo >&2 "!! LICENSE 哈希异常"
    exit 1
}

pkgdesc="A Minecraft Launcher which is multi-functional, cross-platform and popular (upstream prebuilt deb repack)"
arch=('any')
url="https://github.com/HMCL-dev/HMCL"
license=('GPL-3.0-or-later')
depends=('java-runtime' 'hicolor-icon-theme')
# AUR 同功能预编译版；对本机已装的 AUR hmcl（源码版）而言本包是同名替换
conflicts=('hmcl-bin')
provides=("hmcl-bin=$pkgver")
# desktop 改写后校验
makedepends=('desktop-file-utils')

# 重打包保真：自解压 jar 不剥离不拆分（无 ELF 可 strip，声明仅为防本机
# makepkg.conf 开 strip 时的意外改动）；deb 树内无空目录，留 !emptydirs 保布局
options=('!strip' '!debug' '!emptydirs')

source=(
    "HMCL-${pkgver}.deb::https://github.com/HMCL-dev/HMCL/releases/download/${_tag}/HMCL-${pkgver}.deb"
    "LICENSE-$pkgver::https://raw.githubusercontent.com/HMCL-dev/HMCL/${_tag}/LICENSE"
)
# 两项均随版本自动解析，无需人工维护（见上方 digest / raw 流式计算）
sha256sums=(
    "$_expected_sha"
    "$_license_sha"
)

prepare() {
    cd "$srcdir"
    local deb="HMCL-${pkgver}.deb"

    [[ -f "$deb" ]] || { echo >&2 "!! 源 deb 缺失，下载未落盘"; return 1; }
    local size
    size="$(stat -L -c%s "$deb")"
    if (( size < 5242880 )); then
        echo >&2 "!! deb 体积异常（${size} 字节），疑似错误响应页"
        return 1
    fi
    # deb 是 ar 归档：魔数 '!<arch>'（第 8 字节为换行，命令替换会去尾，故取 7 字节）
    if [[ "$(dd if="$deb" bs=1 count=7 2>/dev/null)" != '!<arch>' ]]; then
        echo >&2 "!! ar 魔数校验失败，疑似非官方 deb"
        return 1
    fi
    # makepkg 对 ar 归档按内容探测用 bsdtar 解出三个成员，断言关键成员在位
    [[ -f data.tar.gz ]] || { echo >&2 "!! data.tar.gz 未被解出"; return 1; }
}

package() {
    cd "$srcdir"
    # 唯一第二层：data.tar.gz（gzip 非 zstd，注意与 we-layerd/google-chrome 区分），
    # 整树落位：入口脚本 + 版本化自解压 jar + desktop + hicolor 图标
    bsdtar -xf data.tar.gz -C "$pkgdir/"

    # 版本化主文件必须唯一在位（文件名随版本变化，glob 断言，不硬编码）；
    # 入口脚本缺失则直接失败，不产出坏包
    local mains=( "$pkgdir"/usr/share/java/hmcl/HMCL-*.sh )
    (( ${#mains[@]} == 1 )) && [[ -f "${mains[0]}" ]] || {
        echo >&2 "!! 自解压主文件数量异常，上游 deb 布局可能已变化"
        return 1
    }
    [[ -x "$pkgdir/usr/bin/hmcl-stable" ]] || { echo >&2 "!! 入口脚本缺失"; return 1; }

    # desktop：Icon 由绝对路径改为按名查找（文件已在 hicolor 标准路径，
    # 与文件名 hmcl-stable.png 对应）；Exec 指向的入口真实存在，保留。
    # sed 落空则报错，防止静默打出桌面项损坏的包
    sed -i 's|^Icon=.*|Icon=hmcl-stable|' "$pkgdir/usr/share/applications/hmcl-stable.desktop"
    if ! grep -q '^Icon=hmcl-stable$' "$pkgdir/usr/share/applications/hmcl-stable.desktop"; then
        echo >&2 "!! desktop Icon 改写失败，上游 desktop 结构可能已变化"
        return 1
    fi
    desktop-file-validate "$pkgdir/usr/share/applications/hmcl-stable.desktop"

    install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
