# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版 wayland-pipewire-idle-inhibit：锁定上游 tag，本机零编译
# 升级方法：改 pkgver 为上游新版本号，并用下面这条命令取新 tarball 的校验和
#          curl -sL <tarball url> | sha256sum
# 注意：包名带 -aur 后缀以避免工作流 *.pkg.tar.zst 产物循环匹配；
#       运行时包名/二进制不变（provides 原名）

_pkgname=wayland-pipewire-idle-inhibit
pkgname=${_pkgname}-aur
pkgver=0.7.1
pkgrel=1
pkgdesc="Inhibit wayland idle when computer is playing sound"
arch=('x86_64')
url="https://github.com/rafaelrc7/wayland-pipewire-idle-inhibit"
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'libpipewire')
# rust 提供 cargo+rustc（Arch 仓库已无独立 cargo 包，用 cargo 会让 makepkg 找不到依赖）
makedepends=('rust' 'clang' 'wayland' 'wayland-protocols')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("${_pkgname}-${pkgver}.tar.gz::https://github.com/rafaelrc7/${_pkgname}/archive/refs/tags/v${pkgver}.tar.gz")
# 固定校验和：tarball 源不像 git tag 那样自带版本锚点，SKIP 会让上游移动 tag
# 或仓库被接管时完全不可察觉
sha256sums=('6644562aa9ac0210ae7203453f7d3d38fe9d74059e0864d60e13b45033dc2652')

# 关键：关闭 debug 包生成（否则 makepkg 自动产出 -debug 包）
# + cargo release 二进制默认带完整 debug 符号（~700MB），
#   package() 里必须显式 strip，否则主包也会巨大
options=('!debug' '!emptydirs')

prepare() {
    cd "$_pkgname-$pkgver"
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$_pkgname-$pkgver"
    # 编译缓存与源码分离：统一放 $startdir/target（包目录），由工作流按包缓存
    export CARGO_TARGET_DIR="$startdir/target"
    cargo build --frozen --release
}

package() {
    cd "$_pkgname-$pkgver"
    install -Dm0755 -t "$pkgdir/usr/bin/" "$startdir/target/release/$_pkgname"
    install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENCE
    install -Dm0644 -t "$pkgdir/usr/lib/systemd/user/" wayland-pipewire-idle-inhibit.service
    # Rust release 二进制带完整 debug 符号，必须 strip 才能瘦身到正常大小
    # --strip-unneeded 比 --strip-debug 更彻底（去掉 .debug + 局部符号）
    strip --strip-unneeded "$pkgdir/usr/bin/$_pkgname"
    # 打印 strip 后大小便于日志确认
    ls -lh "$pkgdir/usr/bin/$_pkgname"
}
