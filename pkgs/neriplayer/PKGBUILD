# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版 neriplayer：NeriPlayer Desktop（Tauri 2 + Vue 3 + Rust 音频引擎，
# 网易云 / QQ 音乐 / Bilibili / YouTube Music 多源在线播放）官方预编译 deb 重打包，
# 内置私有 FFmpeg 解码库（usr/lib/NeriPlayer/ffmpeg/，dlopen 加载），零编译零依赖污染。
#
# 版本源：上游已正式发 Release（tag 形如 NeriPlayer-<sha7>.<MMDDHHMM>），每个
# Release 挂 12 个资产，其中 NeriPlayer_<appver>_amd64.deb 是 Linux x64 安装包，
# 另有 SHA256SUMS.txt（含该 deb 的 SHA256）与 build-metadata.txt（含 build_epoch、
# build_git_sha、release_tag）。本包取 releases/latest 的 tag，从同一 Release
# 直接下载 deb 重打包，不再经过 nightly.link 的 artifact zip。
#
# 版本号 = 应用版本（deb 文件名）+ 构建 epoch（build-metadata.txt），pkgver 形如
# 1.0.0.r1793179269，pacman 侧保持单调升级（.r<epoch> 数值递增）。
#
# 升级方法：无需修改 pkgver；每月定时重建或手动 workflow_dispatch 指定 neriplayer
#          即取当时最新 release。上游 app 版本长期为 1.0.0，靠 epoch 区分各次
#          release，因此每次上游发 Release 都会产出一个更高的 pkgver。
#
# 校验：deb 的 SHA256 直接取自该 Release 的 SHA256SUMS.txt，makepkg 落地即校验
#      （早期走 artifact zip 时因无摘要只能 SKIP，现已可硬校验）；主许可证
#      GPL-3.0 从 build_git_sha 对应 raw 流式计算 SHA256。另有体积下限、ar 魔数、
#      deb 结构、版本对账（control Version / 文件名 / build-metadata 三方一致）。

pkgname=neriplayer
pkgrel=1

pkgdesc="A multi-source online music player for Windows/macOS/Linux (Tauri 2 + Vue 3 + Rust audio engine) — upstream prebuilt deb repack"
arch=('x86_64')
url="https://github.com/cwuom/NeriPlayer-Desktop"
# 上游仓库 LICENSE 为标准 GPL-3.0 全文（GitHub 亦标记 GPL-3.0）；内置 FFmpeg 的
# LGPL 许可随捆绑文件保留在 /usr/lib/NeriPlayer/ffmpeg/LICENSE.txt 原位
license=('GPL-3.0-only')
depends=(
    # 主程序 ELF 直接 NEEDED（对 build 出的 deb 逐项核对 soname → 所属包）：
    'webkit2gtk-4.1'   # libwebkit2gtk-4.1.so.0 / libjavascriptcoregtk-4.1.so.0
    'gtk3'             # libgtk-3.so.0 / libgdk-3.so.0
    'libsoup3'         # libsoup-3.0.so.0
    'alsa-lib'         # libasound.so.2
    'dbus'             # libdbus-1.so.3
    'openssl'          # libssl.so.3 / libcrypto.so.3
    'cairo'            # libcairo.so.2
    'gdk-pixbuf2'      # libgdk_pixbuf-2.0.so.0
    'glib2'            # libglib-2.0.so.0 / libgio-2.0.so.0 / libgobject-2.0.so.0
    # gcc-libs 已是元包（拆成 libgcc/libstdc++ 等），按实际提供者精确声明
    'libgcc'           # libgcc_s.so.1
    'libstdc++'        # libstdc++.so.6
    'hicolor-icon-theme'  # 随包安装 hicolor 图标的基础目录
)
makedepends=('desktop-file-utils')
# 重打包保真：不剥离不拆分上游二进制（内置 ffmpeg 解码库与主程序逐字节一致）
options=('!strip' '!debug' '!emptydirs')

# ---- 版本解析：取上游 releases/latest 的 tag ----
_np_latest_tag() {
    local tag
    tag="$(curl -fsSI -o /dev/null -w '%{redirect_url}' \
        'https://github.com/cwuom/NeriPlayer-Desktop/releases/latest' \
        | sed -E 's|.*/tag/([^[:space:]]+).*|\1|' | tr -d '\r')"
    if [[ -z "$tag" ]]; then
        tag="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
            'https://api.github.com/repos/cwuom/NeriPlayer-Desktop/releases/latest' \
            | awk -F'"' '/"tag_name":/{print $4; exit}')"
    fi
    [[ -n "$tag" ]] || return 1
    printf '%s\n' "$tag"
}

_tag="$(_np_latest_tag)" || {
    echo >&2 "!! 无法解析 NeriPlayer 最新 release tag，网络或仓库结构可能已变化"
    exit 1
}
# tag 形态：NeriPlayer-<7 位 sha>.<MMDDHHMM>；不符即终止，避免把别的 tag 当版本
[[ "$_tag" =~ ^NeriPlayer-[0-9a-f]{7}\.[0-9]{8}$ ]] || {
    echo >&2 "!! release tag 形态异常：${_tag:-（空）}"
    exit 1
}

_urlrel="https://github.com/cwuom/NeriPlayer-Desktop/releases/download/${_tag}"

# 该 Release 的两个元数据资产（体积均为几百字节，直接全文取回后解析）
_sums="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 "$_urlrel/SHA256SUMS.txt")" || {
    echo >&2 "!! 无法获取 $_urlrel/SHA256SUMS.txt"
    exit 1
}
_meta="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 "$_urlrel/build-metadata.txt")" || {
    echo >&2 "!! 无法获取 $_urlrel/build-metadata.txt"
    exit 1
}

_deb_name="$(awk '$2 ~ /_amd64\.deb$/ {print $2; exit}' <<<"$_sums" | tr -d '\r')"
_deb_sha="$(awk '$2 ~ /_amd64\.deb$/ {print $1; exit}' <<<"$_sums" | tr -d '\r')"
_build_epoch="$(awk -F= '$1=="build_epoch" {print $2; exit}' <<<"$_meta" | tr -d '\r')"
_build_sha="$(awk -F= '$1=="build_git_sha" {print $2; exit}' <<<"$_meta" | tr -d '\r')"
_meta_tag="$(awk -F= '$1=="release_tag" {print $2; exit}' <<<"$_meta" | tr -d '\r')"

[[ -n "$_deb_name" ]] || {
    echo >&2 "!! SHA256SUMS.txt 中未找到 amd64 deb，上游资产命名可能已变化"
    exit 1
}
[[ "$_deb_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo >&2 "!! deb 的 SHA256 异常：${_deb_sha:-（空）}"
    exit 1
}
[[ "$_build_epoch" =~ ^[0-9]+$ ]] || {
    echo >&2 "!! build_epoch 解析失败：${_build_epoch:-（空）}"
    exit 1
}
[[ "$_build_sha" =~ ^[0-9a-f]{40}$ ]] || {
    echo >&2 "!! build_git_sha 解析失败：${_build_sha:-（空）}"
    exit 1
}
# 元数据必须自报同一个 release tag，防止 latest 解析与资产内容错位
[[ "$_meta_tag" == "$_tag" ]] || {
    echo >&2 "!! 元数据 tag（${_meta_tag:-（空）}）≠ 解析出的 release tag（$_tag）"
    exit 1
}

# 应用版本取自 deb 资产名 NeriPlayer_<appver>_amd64.deb，与 control 由 prepare() 对账
_app_ver="${_deb_name#NeriPlayer_}"
_app_ver="${_app_ver%_amd64.deb}"
[[ "$_app_ver" =~ ^[0-9]+(\.[0-9A-Za-z]+)*$ ]] || {
    echo >&2 "!! 解析 deb 文件名版本失败：${_app_ver:-（空）}"
    exit 1
}

pkgver="${_app_ver}.r${_build_epoch}"
[[ "$pkgver" =~ ^[0-9]+(\.[0-9A-Za-z]+)*\.r[0-9]+$ ]] || {
    echo >&2 "!! pkgver 异常：$pkgver"
    exit 1
}

# 主许可证：从该 Release 的 build_git_sha 取 raw LICENSE，流式计算 SHA256
_license_sha="$(set -o pipefail; curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
    "https://raw.githubusercontent.com/cwuom/NeriPlayer-Desktop/${_build_sha}/LICENSE" \
    | sha256sum | cut -d' ' -f1)" || {
    echo >&2 "!! LICENSE 获取失败"
    exit 1
}
[[ "$_license_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo >&2 "!! LICENSE 哈希异常"
    exit 1
}

# 源文件名带 pkgver 做缓存隔离（同 app 版本靠 epoch 区分），下载源仍是上游固定名
_deb="NeriPlayer_${_app_ver}_amd64-${pkgver}.deb"
source=(
    "${_deb}::${_urlrel}/${_deb_name}"
    "LICENSE-${pkgver}::https://raw.githubusercontent.com/cwuom/NeriPlayer-Desktop/${_build_sha}/LICENSE"
)
sha256sums=(
    "$_deb_sha"
    "$_license_sha"
)
# deb 是 ar 归档，makepkg 的内容探测会把它当 tar 自动解开；这里保持原件，
# 由 prepare() 显式解包，避免依赖 makepkg 的探测分支
noextract=("$_deb")

prepare() {
    cd "$srcdir"

    [[ -f "$_deb" ]] || { echo >&2 "!! 源文件 $_deb 缺失，下载未落盘"; return 1; }

    local size
    size="$(stat -L -c%s "$_deb")"
    if (( size < 31457280 )); then
        echo >&2 "!! deb 体积异常（${size} 字节），疑似错误响应或截断"
        return 1
    fi
    # deb 是 ar 归档：魔数 '!<arch>'（第 8 字节为换行，命令替换会去尾，故取 7 字节）
    if [[ "$(dd if="$_deb" bs=1 count=7 2>/dev/null)" != '!<arch>' ]]; then
        echo >&2 "!! ar 魔数校验失败，疑似非官方 deb"
        return 1
    fi

    # 解出 ar 成员：debian-binary / control.tar.gz / data.tar.gz
    bsdtar -xf "$_deb" || { echo >&2 "!! deb 解包失败"; return 1; }
    [[ -f data.tar.gz ]] || { echo >&2 "!! deb 未解出 data.tar.gz"; return 1; }
    [[ -f control.tar.gz ]] || { echo >&2 "!! deb 未解出 control.tar.gz"; return 1; }

    # 版本对账：deb control 的 Version（剥掉可能的 Debian revision）必须与 pkgver
    # 的应用版本部分一致，防止打包错版本
    local ctl_ver
    ctl_ver="$(bsdtar -xOf control.tar.gz control 2>/dev/null \
        | awk '/^Version:/{print $2; exit}' | tr -d '\r')"
    ctl_ver="${ctl_ver%%-*}"
    if [[ "$ctl_ver" != "$_app_ver" ]]; then
        echo >&2 "!! 版本对账失败：deb control Version=${ctl_ver:-（空）} ≠ 文件名版本 ${_app_ver}"
        return 1
    fi

    [[ -f "LICENSE-${pkgver}" ]] || { echo >&2 "!! LICENSE 源缺失，下载未落盘"; return 1; }
}

package() {
    cd "$srcdir"
    # 第二层解包：deb 的 data.tar.gz，整树落位
    bsdtar -xf data.tar.gz -C "$pkgdir/"

    # 主程序（动态链接，直接 NEEDED webkit2gtk-4.1/gtk3/libsoup3 等，见 depends）
    [[ -x "$pkgdir/usr/bin/neri-player-desktop" ]] || {
        echo >&2 "!! 主程序缺失或不可执行，上游 deb 布局可能已变化"
        return 1
    }

    # 内置 FFmpeg 解码库（dlopen 加载、无 NEEDED 关联，随包原样保留布局）
    [[ -f "$pkgdir/usr/lib/NeriPlayer/ffmpeg/libavcodec.so.63" ]] || {
        echo >&2 "!! 内置 ffmpeg 解码库缺失，上游 deb 布局可能已变化"
        return 1
    }

    # 桌面项与图标（上游命名无空格无歧义，原样保留）
    [[ -f "$pkgdir/usr/share/applications/NeriPlayer.desktop" ]] || {
        echo >&2 "!! desktop 缺失，上游 deb 布局可能已变化"
        return 1
    }
    desktop-file-validate "$pkgdir/usr/share/applications/NeriPlayer.desktop" || return 1
    [[ -f "$pkgdir/usr/share/icons/hicolor/512x512/apps/neri-player-desktop.png" ]] || {
        echo >&2 "!! 512 图标缺失，上游 deb 布局可能已变化"
        return 1
    }

    # 兜底：断言装包即能启动，不把缺库的坏包打出来
    if ldd "$pkgdir/usr/bin/neri-player-desktop" 2>/dev/null | grep -q 'not found'; then
        echo >&2 "!! 主程序仍有缺失的动态库："
        ldd "$pkgdir/usr/bin/neri-player-desktop" 2>/dev/null | grep 'not found' >&2 || true
        return 1
    fi

    # 主许可证：GPL-3.0 全文落位 /usr/share/licenses
    install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    ls -lh "$pkgdir/usr/bin/" "$pkgdir/usr/lib/NeriPlayer/ffmpeg/" 2>/dev/null || true
}
