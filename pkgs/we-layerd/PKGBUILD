# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版 we-layerd：重打包上游官方预编译 Ubuntu amd64 deb（v0.2.8 起上游
# release 附带完整产物）。deb 内私有捆绑了 CEF（usr/lib/cef/）与 DXC
# （usr/lib/we-layerd/dxc/）运行时，二进制经 $ORIGIN 相对 RUNPATH 加载——
# 相比旧源码构建版彻底去掉 AUR 的 cef / directx-shader-compiler 两个前置依赖，
# 本机零编译、pacman 官方源即可满足全部依赖。
# 升级方法：无需修改 pkgver；构建时解析 releases/latest 取最新 tag（302 + API 兜底），
#          deb 文件名与 SHA256 从该 tag 的 SHA256SUMS 动态解析，makepkg 落地即校验
#
# 注意：
# - deb 二进制为 Ubuntu 构建版，we-gui 要求 GLIBC_2.43+，Arch 滚动 glibc 始终
#   满足；gstreamer/gtk 等 soname bump 由每月 1 号的定时全量重建兜底
# - deb 的 postinst/postrm 仅做 deb-systemd-user-helper 处理，Arch 无对应需求，
#   用户服务（/usr/lib/systemd/user/we-layerd.service）按需 systemctl --user enable
# - 上游仓库至今不含 LICENSE（deb copyright 声明 all-rights-reserved 且注明
#   "intended for local testing"），本仓库为个人云端构建，仅自用不分发

pkgname=we-layerd
pkgrel=1

_we_layerd_latest_tag() {
    local tag
    tag="$(curl -fsSI -o /dev/null -w '%{redirect_url}' \
        'https://github.com/Aromatic05/we-layerd/releases/latest' \
        | sed -E 's|.*/tag/([^[:space:]]+).*|\1|' | tr -d '\r')"
    if [[ -z "$tag" ]]; then
        # 302 解析失败回退 GitHub API（releases/latest 只指向非 prerelease 稳定版）
        tag="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
            'https://api.github.com/repos/Aromatic05/we-layerd/releases/latest' \
            | awk '/"tag_name":/{print $2}' | tr -d ',"')"
    fi
    [[ -n "$tag" ]] || return 1
    printf '%s\n' "$tag"
}

_tag="$(_we_layerd_latest_tag)" || {
    echo >&2 "!! 无法解析 we-layerd 最新 release tag，网络或仓库结构可能已变化"
    exit 1
}
pkgver="${_tag#v}"
[[ "$pkgver" =~ ^[0-9]+(\.[0-9]+)+$ ]] || {
    echo >&2 "!! 解析出版本号异常：${pkgver:-（空）}"
    exit 1
}

# 从该 tag 的 SHA256SUMS 动态解析 deb 文件名（不硬编码 debian revision）与 SHA256，
# 一次 curl 存下结果避免重复请求；SHA256 由 makepkg 下载后落地校验。
_sums="$(curl -fsSL --connect-timeout 15 --max-time 60 --retry 2 \
    "https://github.com/Aromatic05/we-layerd/releases/download/${_tag}/SHA256SUMS")" || {
    echo >&2 "!! 获取 SHA256SUMS 失败"
    exit 1
}
_asset="$(printf '%s\n' "$_sums" | grep -oE 'we-layerd_[^/ ]+_amd64\.deb$' | head -n1)"
[[ -n "$_asset" ]] || {
    echo >&2 "!! SHA256SUMS 中未找到 amd64 deb 资产"
    exit 1
}
_expected_sha="$(printf '%s\n' "$_sums" | grep "${_asset}\$" | awk '{print $1}')"
[[ "$_expected_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo >&2 "!! 解析 deb SHA256 失败"
    exit 1
}
pkgdesc="A native Wallpaper Engine runtime for Linux Wayland (niri/Hyprland/KDE/GNOME) (upstream prebuilt deb repack)"
arch=('x86_64')
url="https://github.com/Aromatic05/we-layerd"
# 上游 v0.2.8 仓库内不含任何 LICENSE/COPYING 文件，官方 Arch PKGBUILD 亦声明为
# custom:unlicensed——此处不得写成 MIT
license=('custom:unlicensed')
depends=(
    # we-layerd 守护进程本体（glibc/gcc-libs 由 base 隐式提供）
    'libpulse'
    'wayland'
    # renderer.so 是 dlopen 加载的，链接以下库：符号到运行时才解析，
    # 缺一个就装完启动即失败
    'gstreamer'
    'gst-plugins-base-libs'   # libgstapp/libgstvideo/libgstallocators
    'gst-plugins-bad-libs'    # libgstva（GStreamer VA-API 桥）
    'libva'
    'vulkan-icd-loader'
    'lz4'
    'fontconfig'
    'freetype2'
    'pango'
    'cairo'
    'glib2'
    # 视频壁纸：解封装器/解码器插件由 GStreamer 运行时 dlopen，必须实装
    # （对齐 deb Depends 的 plugins-base/good/bad/libav）
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
    'gst-libav'
    # we-gui：GTK3 界面 + 系统托盘（dlopen libayatana-appindicator3）+ libxdo
    'gtk3'
    'gdk-pixbuf2'
    'libayatana-appindicator'
    'xdotool'
    # 内置私有 CEF 的宿主库（旧源码构建版来自 AUR cef 包的依赖链）
    'nss'
    'nspr'
    'alsa-lib'
    'libcups'
    'at-spi2-core'
    'dbus'
    'expat'
    'zlib'
    'mesa'          # libgbm
    'libdrm'        # DMA-BUF 零拷贝路径
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxrandr'
    'libxkbcommon'
    'systemd-libs'  # libudev
    'hicolor-icon-theme'
)
# deb 的 Suggests: gnome-shell——GNOME 扩展随包安装，仅 GNOME 会话用到
optdepends=('gnome-shell: GNOME 桌面壁纸集成（bundled 扩展 we-layerd@aromatic）')

# 重打包保真：不剥离不拆分上游二进制（上游已 strip，二进制自带 RUNPATH 指向
# 私有 CEF/DXC，strip 不影响加载，但按仓库约定保持逐字节一致）
# deb 树内无空目录，留 !emptydirs 仅为布局保真
options=('!strip' '!debug' '!emptydirs')

# 产物安装后约 390MB（整套私有 CEF），namcap 扫描该体积会严重拖慢 CI，
# 同 google-chrome/wechat 显式关闭；依赖已按 deb Depends + 实测 NEEDED 逐项核对
namcap_check=false

source=("https://github.com/Aromatic05/we-layerd/releases/download/${_tag}/${_asset}")
sha256sums=("$_expected_sha")

prepare() {
    cd "$srcdir"
    local deb="$_asset"

    [[ -f "$deb" ]] || { echo >&2 "!! 源 deb 缺失，下载未落盘"; return 1; }
    local size
    size="$(stat -L -c%s "$deb")"
    if (( size < 104857600 )); then
        echo >&2 "!! deb 体积异常（${size} 字节），疑似错误响应页"
        return 1
    fi
    # deb 是 ar 归档：魔数 '!<arch>'（第 8 字节为换行，命令替换会去尾，故取 7 字节）
    if [[ "$(dd if="$deb" bs=1 count=7 2>/dev/null)" != '!<arch>' ]]; then
        echo >&2 "!! ar 魔数校验失败，疑似非官方 deb"
        return 1
    fi
    # makepkg 对 ar 归档按内容探测用 bsdtar 解出三个成员，断言关键成员在位
    [[ -f data.tar.zst ]] || { echo >&2 "!! data.tar.zst 未被解出"; return 1; }
}

package() {
    cd "$srcdir"
    # 第二层解包：data.tar.zst（libarchive bsdtar 原生支持 zstd），整树落位
    bsdtar -xf data.tar.zst -C "$pkgdir/"

    # 按 pacman 约定把主许可证落位到 /usr/share/licenses；
    # share/doc 下的 third-party/（CEF/DXC 许可全文）原样保留，copyright 内有引用
    install -Dm644 "$pkgdir/usr/share/doc/we-layerd/copyright" \
        "$pkgdir/usr/share/licenses/$pkgname/copyright"

    # 打印体积便于日志确认（内置 CEF 约占八成）
    du -sh "$pkgdir/usr/lib/cef" "$pkgdir/usr/lib/we-layerd" 2>/dev/null || true
    ls -lh "$pkgdir/usr/bin/" 2>/dev/null || true
}
