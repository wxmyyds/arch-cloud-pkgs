# Maintainer: wxmyyds <wxmyyds0601@163.com>
# 云端构建版 we-layerd：锁定上游 tag，完整功能（scene/video/web）
# 升级方法：改 pkgver 为上游新版本号，然后 sha256sums 保持 SKIP（git tag 源）

_pkgname=we-layerd
pkgname=$_pkgname
pkgver=0.2.7
pkgrel=1
pkgdesc="A native Wallpaper Engine runtime for Linux Wayland (niri/Hyprland/KDE/GNOME)"
arch=('x86_64')
url="https://github.com/Aromatic05/we-layerd"
license=('MIT')
depends=(
    'gtk3'
    'wayland'
    'libxkbcommon'
    'vulkan-icd-loader'
    'libglvnd'
    'mesa'
    'gstreamer'
    'gst-plugins-base-libs'
    'gst-libav'
    # 视频壁纸需要完整插件集（qtdemux 等解封装器）
    'gst-plugins-base'
    'gst-plugins-good'
    'lz4'
    'pango'
    'fontconfig'
    'freetype2'
    'xdotool'
    # 运行时必需：renderer 链接受 libdxcompiler.so，web helper 受 libcef.so
    'cef'
    'directx-shader-compiler'
    # we-gui 系统托盘图标
    'libayatana-appindicator'
)
makedepends=(
    'git'
    'rust'
    'cmake'
    'wayland-protocols'
    'vulkan-headers'
    'gstreamer'
    'gst-plugins-bad-libs'
    'gst-plugins-good'
)
provides=("we-layerd")
conflicts=("we-layerd")
source=("$_pkgname::git+https://github.com/Aromatic05/we-layerd.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
    cd "$_pkgname"
    # 上游要求初始化 renderer 子模块（AUR 坑包就是漏了这步）
    git submodule update --init --recursive
}

build() {
    cd "$_pkgname"
    export CARGO_TARGET_DIR="$srcdir/$_pkgname/target"
    cargo build --locked --release --workspace
}

package() {
    cd "$_pkgname"
    DESTDIR="$pkgdir" cargo xtask install --prefix /usr
}
