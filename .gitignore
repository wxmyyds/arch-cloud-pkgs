# 构建产物
*.pkg.tar.zst
*.pkg.tar.xz
*.pacman

# makepkg 工作目录
src/
pkg/
target/
.deps/

# PKGBUILD 额外吐出的裸二进制（见 build.conf 的 extra_artifacts）
# 以及工作流收集它们时用到的临时目录
pkgs/*/extra_artifacts/
pkgs/*/rtk-aarch64-android

# neriplayer 构建期从 nightly.link 下载的 artifact 与解析出的元数据（防误提交）
pkgs/neriplayer/NeriPlayer-Linux-x64-*.zip
pkgs/neriplayer/build-metadata.txt

